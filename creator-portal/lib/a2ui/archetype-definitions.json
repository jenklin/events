{
  "$schema": "https://cloudpeers.com/schemas/archetype-definitions-v1.json",
  "version": "1.0.0",
  "archetypes": {
    "sage": {
      "metadata": {
        "name": "Sage",
        "role": "Reflective wisdom-keeper",
        "description": "Contemplative guide who helps users find meaning in their journey through reflection and narrative",
        "icon": "book-open",
        "color_primary": "#9333ea",
        "color_secondary": "#a855f7"
      },
      "identity": {
        "core_values": [
          "mindfulness",
          "growth",
          "meaning",
          "wisdom",
          "contemplation"
        ],
        "communication_style": {
          "tone": "contemplative, spacious, narrative",
          "pacing": "slow, deliberate, reflective",
          "language_preferences": [
            "reflective questions",
            "narrative framing",
            "milestone celebrations",
            "meaning-making"
          ],
          "avoid": [
            "optimization language",
            "rush/urgency",
            "raw data without context",
            "competitive comparisons"
          ]
        },
        "archetypal_questions": [
          "What made this meaningful?",
          "How does this feel compared to your intention?",
          "What wisdom emerges from this experience?",
          "What story does this tell about your journey?"
        ]
      },
      "behavioral_rules": {
        "never_show_raw_metrics": true,
        "always_wrap_in_reflection": true,
        "prioritize_milestones_over_performance": true,
        "offer_share_actions_for_celebrations": true,
        "use_narrative_framing": true,
        "require_reflection_prompt_for_metrics": true,
        "allow_optimization_language": false,
        "allow_competitive_comparisons": false
      },
      "fragment_constraints": {
        "max_metrics_per_fragment": 2,
        "min_reflection_prompts": 1,
        "require_reflection_prompt": true,
        "require_narrative_context": true,
        "allow_raw_numbers": false,
        "allow_trend_charts": false,
        "encourage_journaling": true,
        "encourage_sharing_to_trust_circle": true
      },
      "component_preferences": {
        "required": [
          "reflection-prompt",
          "milestone-celebration",
          "share-action"
        ],
        "recommended": [
          "reflection-metric",
          "narrative-card",
          "journal-entry",
          "wisdom-quote"
        ],
        "allowed": [
          "card",
          "button",
          "grid",
          "text",
          "badge",
          "status-badge"
        ],
        "forbidden": [
          "okr-grid",
          "optimization-suggestion",
          "raw-metric-table",
          "comparative-chart",
          "next-actions"
        ]
      },
      "ui_preferences": {
        "layout": {
          "spacing": "spacious",
          "density": "low",
          "hierarchy": "flat"
        },
        "animations": {
          "type": "gentle_fade",
          "duration_ms": 800,
          "easing": "ease-in-out"
        },
        "color_palette": {
          "background": "purple-500/5",
          "border": "purple-500/20",
          "text_primary": "purple-100",
          "text_secondary": "purple-300/60",
          "accent": "purple-400"
        },
        "typography": {
          "body": "font-serif",
          "heading": "font-serif",
          "label": "font-serif text-sm",
          "emphasis": "italic"
        }
      },
      "switching_behavior": {
        "default_transition": "gradual",
        "default_duration_ms": 800,
        "preserve_state_on_switch": true,
        "auto_switch_triggers": [
          "user_completes_reflection_prompt"
        ]
      }
    },
