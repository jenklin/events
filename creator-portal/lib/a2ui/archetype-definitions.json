  "switching_protocols": [
    {
      "from": "sage",
      "to": "strategist",
      "transition": "gradual",
      "duration_ms": 800,
      "preserve_state": true,
      "animation": "fade_crossfade",
      "trigger_conditions": [
        "user_selects_strategist_mode",
        "user_completes_reflection_prompt",
        "user_requests_optimization"
      ],
      "rationale": "Sage users transitioning to action need time to shift mindset"
    },
    {
      "from": "sage",
      "to": "guardian",
      "transition": "instant",
      "duration_ms": 200,
      "preserve_state": false,
      "animation": "rapid_replace",
      "trigger_conditions": [
        "safety_concern_raised",
        "user_selects_guardian_mode"
      ],
      "auto_switch": true,
      "rationale": "Safety concerns require immediate attention, override contemplation"
    },
    {
      "from": "sage",
      "to": "connector",
      "transition": "gradual",
      "duration_ms": 600,
      "preserve_state": true,
      "animation": "gentle_fade",
      "trigger_conditions": [
        "user_selects_connector_mode",
        "user_requests_sharing",
        "community_activity_detected"
      ],
      "rationale": "Natural transition from personal reflection to social sharing"
    },
    {
      "from": "strategist",
      "to": "sage",
      "transition": "gradual",
      "duration_ms": 1000,
      "preserve_state": true,
      "animation": "slow_fade",
      "trigger_conditions": [
        "user_selects_sage_mode",
        "goal_milestone_reached",
        "user_requests_reflection"
      ],
      "rationale": "Strategist users need time to slow down and reflect"
    },
    {
      "from": "strategist",
      "to": "guardian",
      "transition": "instant",
      "duration_ms": 200,
      "preserve_state": false,
      "animation": "rapid_replace",
      "trigger_conditions": [
        "budget_overage_detected",
        "health_alert_triggered",
        "safety_concern_raised",
        "limit_exceeded"
      ],
      "auto_switch": true,
      "rationale": "Safety alerts must interrupt optimization focus immediately"
    },
    {
      "from": "strategist",
      "to": "connector",
      "transition": "gradual",
      "duration_ms": 600,
      "preserve_state": true,
      "animation": "fade_crossfade",
      "trigger_conditions": [
        "user_selects_connector_mode",
        "achievement_ready_to_share",
        "collaboration_opportunity_detected"
      ],
      "rationale": "Transition from individual achievement to collective celebration"
    },
    {
      "from": "guardian",
      "to": "sage",
      "transition": "gradual",
      "duration_ms": 1000,
      "preserve_state": false,
      "animation": "gentle_fade",
      "trigger_conditions": [
