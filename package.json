{
  "name": "cloudpeers-events",
  "version": "2.0.0",
  "description": "cloudpeers Events Platform - Multi-tenant event management with creator portal, event pages, and photo galleries",
  "private": true,
  "workspaces": [
    "creator-portal",
    "gallery"
  ],
  "scripts": {
    "dev:portal": "cd creator-portal && npm run dev",
    "dev:gallery": "cd gallery && npm run dev",
    "build:portal": "cd creator-portal && npm run build",
    "build:gallery": "cd gallery && npm run build",
    "generate:event": "cd event-pages/generator && tsx generate.ts",
    "generate:example": "cd event-pages/generator && tsx generate.ts ../example-config.json",
    "install:all": "npm install && cd creator-portal && npm install",
    "clean": "rm -rf creator-portal/.next gallery/.next event-pages/output/*",
    "typecheck": "cd creator-portal && tsc --noEmit",
    "deploy:staging": "./deploy.sh staging",
    "deploy:prod": "./deploy.sh prod",
    "deploy:ga": "./deploy.sh prod"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
