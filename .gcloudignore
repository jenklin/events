# .gcloudignore for CloudPeers Events Service
# Excludes files from Cloud Build uploads to reduce size and speed up deployments

# Node modules (will be installed during Docker build)
node_modules/
**/node_modules/

# Build outputs (generated during Docker build)
.next/
**/.next/
dist/
**/dist/
build/
**/build/

# Git
.git/
.gitignore

# Development files
.env.local
.env*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
**/.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Test and coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Documentation (not needed for deployment)
*.md
!README.md

# Examples and archives
archive/
examples/
